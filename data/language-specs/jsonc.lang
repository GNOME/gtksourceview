<language id="jsonc" name="JSONC" version="2.0" _section="Other">
  <metadata>
    <property name="mimetypes">application/jsonc</property>
    <property name="globs">*.jsonc</property>
    <property name="suggested-suffix">.jsonc</property>
    <property name="line-comment-start">//</property>
    <property name="block-comment-start">/*</property>
    <property name="block-comment-end">*/</property>
  </metadata>

  <styles>
    <style id="comment"    name="Comment"       map-to="def:comment"/>
    <style id="keyname"    name="Key"           map-to="def:constant"/>
    <style id="null-value" name="Null Value"    map-to="js:null-value"/>
    <style id="boolean"    name="Boolean Value" map-to="js:boolean"/>
  </styles>

  <definitions>
    <context id="jsonc-object">
      <start>\{</start>
      <end>\}</end>
      <include>
        <context ref="def:c-like-comment"/>
        <context ref="def:c-like-comment-multiline"/>
        <context ref="def:c-like-close-comment-outside-comment"/>
        <context ref="json:string" style-ref="keyname"/>
        <context>
          <start>:</start>
          <end>,|\s*(?=})</end>
          <include>
            <context sub-pattern="0" where="start" style-ref="keyname"/>
            <context ref="json:value"/>
          </include>
        </context>
        <context ref="json:catchall"/>
      </include>
    </context>
 
    <replace id="json:object" ref="jsonc-object"/>

    <context id="jsonc-value">
      <include>
        <context ref="def:c-like-comment"/>
        <context ref="def:c-like-comment-multiline"/>
        <context ref="def:c-like-close-comment-outside-comment"/>
        <context ref="json:object"/>
        <context ref="json:array"/>
        <context ref="json:string"/>
        <context ref="json:float"/>
        <context ref="json:decimal"/>
        <context ref="js-lit:null-value" style-ref="null-value"/>
        <context ref="js-lit:boolean" style-ref="boolean"/>
        <context ref="json:catchall"/>
      </include>
    </context>

    <replace id="json:value" ref="jsonc-value"/>

    <context id="jsonc" class="no-spell-check">
      <include>
        <context ref="json:value"/>
      </include>
    </context>
  </definitions>
</language>
