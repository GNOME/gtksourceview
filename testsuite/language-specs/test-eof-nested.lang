<?xml version="1.0" encoding="UTF-8"?>
<language id="test-eof-nested" name="Test EOF nested" version="2.0" hidden="true">
  <styles>
    <style id="escape" name="Escape" map-to="def:special-char"/>
  </styles>
  <definitions>
    <context id="parent">
      <start>start</start>
      <end>neverends</end>
      <include>
        <context id="escape" style-ref="escape" class="escape"><match>\\n</match></context>
      </include>
    </context>
    <context id="test-eof-nested">
      <include>
        <context ref="parent"/>
      </include>
    </context>
  </definitions>
</language>
